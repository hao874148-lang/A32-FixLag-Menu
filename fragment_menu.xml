<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_title"
            android:textColor="@color/neon_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 1. Kịch bản hệ thống -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_card_dark"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_section_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgSystemProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbUltimateGaming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ultimate Gaming (720p HD+ | Lock 90Hz | SkiaVK | Tắt GOS)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbDailyBalanced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Balanced (1080p FHD+ | Lock 90Hz | Mượt One UI)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbBatterySaver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery Saver (1080p | Lock 60Hz | Hạ xung)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btnApplyProfile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/neon_purple"
                android:text="@string/btn_apply_profile"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- 2. Tần số quét 90Hz -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_card_dark"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refresh_rate_section_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnForce90Hz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/bg_card_highlight"
                    android:text="Ép Khóa 90Hz"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnForce60Hz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@color/bg_card_highlight"
                    android:text="Khóa 60Hz"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Ma trận độ phân giải VIP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_card_dark"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resolution_section_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3">

                <Button
                    android:id="@+id/btnRes1080p"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="@color/bg_card_highlight"
                    android:text="1080p Native"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp" />

                <Button
                    android:id="@+id/btnRes900p"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="@color/bg_card_highlight"
                    android:text="900p Balanced"
                    android:textColor="@color/neon_green"
                    android:textSize="9sp" />

                <Button
                    android:id="@+id/btnRes810p"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="@color/bg_card_highlight"
                    android:text="810p Smooth"
                    android:textColor="@color/neon_cyan"
                    android:textSize="9sp" />

                <Button
                    android:id="@+id/btnRes720p"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="@color/bg_card_highlight"
                    android:text="720p Gaming"
                    android:textColor="@color/neon_orange"
                    android:textSize="9sp" />

                <Button
                    android:id="@+id/btnRes640p"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="@color/bg_card_highlight"
                    android:text="640p Super FPS"
                    android:textColor="@color/neon_red"
                    android:textSize="9sp" />

                <Button
                    android:id="@+id/btnRes540p"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="@color/bg_card_highlight"
                    android:text="540p Extreme"
                    android:textColor="@color/neon_gold"
                    android:textSize="9sp" />
            </GridLayout>
        </LinearLayout>

        <!-- 4. GOS & Restores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_card_dark"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gos_section_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnToggleGos"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/neon_red"
                android:text="@string/btn_disable_gos"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnRestoreDefault"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/bg_card_highlight"
                android:text="@string/btn_restore_default"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>